{
  "name": "privateday",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Landing pages do AUVP Private Day, uma pasta por edição, publicadas juntas",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "css": "tailwindcss -c 2027/tailwind.config.js -o 2027/css/tailwind.css --minify",
    "test": "node --test scripts/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=22"
  }
}
